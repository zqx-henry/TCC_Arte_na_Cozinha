# Arte na Cozinha — configurações do Apache
Options -Indexes
DirectoryIndex index.php

# Bloqueia acesso direto a pastas internas
RewriteEngine On
RewriteRule ^(includes|database|scripts|docs)(/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]

# Força HTTPS quando publicado (RNF10). Descomente na hospedagem com SSL:
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache de arquivos estáticos (RNF09 — desempenho)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
